DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (Gmail SMTP) ---
# Leave blank to use console backend during development
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=EXPENZO <noreply@expenzo.app>

# --- Google OAuth 2.0 ---
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback/
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/

# --- Optional Overrides ---
EMAIL_VERIFICATION_TIMEOUT=86400
DATABASE_URL=
